# Copy to .env and fill in. Never commit .env.
PORT=8787
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console → APIs & Services → Credentials.
# Add your site origins (e.g. https://beyondlogik.com and http://localhost:3100) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# A long random string; signs the login cookie. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# The prize shown in the bonfire, e.g. ₹25,000. Leave empty to show "to be announced".
PRIZE=
# The contest runs by this time zone's calendar month.
CONTEST_TZ=Asia/Kolkata
# Firestore: a service-account key file (Firebase console → Project settings → Service accounts → Generate new private key).
# Keep it in secrets/ (git-ignored). Collections are prefixed so they never mix with other apps in the same project.
FIREBASE_SERVICE_ACCOUNT=./secrets/firebase-service-account.json
FIRESTORE_PREFIX=sirpi_
